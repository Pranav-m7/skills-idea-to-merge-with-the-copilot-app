<section class="bookmarks" aria-labelledby="bookmark-form-title">
  <div class="intro">
    <p class="eyebrow">YOUR LINKS, CLOSE AT HAND</p>
    <h2 id="bookmark-form-title">Save a bookmark</h2>
    <p class="description">Drop in a link and give it a little mona- magic.</p>
  </div>

  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com/your-favorite-page"
        required
      />
    </div>
    <button type="submit">Add bookmark <span aria-hidden="true">↗</span></button>
  </form>

  <p class="hint">A missing <code>https://</code> is no problem — we'll add it for you.</p>
  <p id="status" class="status" role="status" aria-live="polite"></p>

  <p id="empty-state" class="empty">
    <span class="empty-icon" aria-hidden="true">✳</span>
    <strong>Your reading list starts here.</strong>
    <span>Save a link above and its short code will show up here.</span>
  </p>

  <div id="list-header" hidden>
    <div>
      <h2 class="list-title">Saved bookmarks</h2>
      <p class="list-count" id="list-count"></p>
    </div>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
  import { formatBookmark, loadBookmarks, normalizeUrl } from '../lib/bookmarks.js';

  const STORAGE_KEY = 'mona-bookmarks';
  const alphabet = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const listCount = document.getElementById('list-count');
  const status = document.getElementById('status');
  let bookmarks = [];

  function readBookmarks() {
    try {
      return loadBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function saveBookmarks() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
      return true;
    } catch {
      status.textContent = 'This browser could not save your bookmarks.';
      return false;
    }
  }

  function createSlug() {
    const randomValues = new Uint32Array(4);
    crypto.getRandomValues(randomValues);
    const suffix = Array.from(randomValues, (value) => alphabet[value % alphabet.length]).join('');
    return `mona-${suffix}`;
  }

  function render() {
    list.replaceChildren();
    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
    listCount.textContent = hasBookmarks
      ? `${bookmarks.length} ${bookmarks.length === 1 ? 'link' : 'links'}`
      : '';

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;
      link.setAttribute('aria-label', `Open ${formatBookmark(bookmark)} in a new tab`);

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('code');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          status.textContent = `${bookmark.slug} copied to clipboard.`;
        } catch {
          status.textContent = 'Could not copy the bookmark code.';
        }
      });

      item.append(link, separator, slug, copyButton);
      list.append(item);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    status.textContent = '';

    try {
      const url = normalizeUrl(input.value);
      let slug = createSlug();
      while (bookmarks.some((bookmark) => bookmark.slug === slug)) {
        slug = createSlug();
      }

      bookmarks = [...bookmarks, { url, slug }];
      saveBookmarks();
      render();
      input.value = '';
      input.focus();
    } catch {
      status.textContent = 'Enter a valid web address, such as example.com.';
      input.focus();
    }
  });

  document.getElementById('clear-all')?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    try {
      localStorage.removeItem(STORAGE_KEY);
      status.textContent = '';
    } catch {
      status.textContent = 'Bookmarks were cleared here, but browser storage could not be updated.';
    }
    render();
  });

  bookmarks = readBookmarks();
  render();
</script>

<style>
  .bookmarks {
    padding: 1.5rem;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--border));
    border-radius: 1rem;
    background: linear-gradient(145deg, color-mix(in srgb, var(--accent) 7%, transparent), transparent 60%);
    box-shadow: 0 1.5rem 4rem #00000012;
  }
  .intro { margin-bottom: 1.25rem; }
  .eyebrow {
    margin: 0 0 0.4rem;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .intro h2 {
    margin: 0;
    font-family: var(--font-head);
    font-size: 1.35rem;
  }
  .description { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.9rem; }
  form { margin-top: 1.25rem; }
  form button { white-space: nowrap; }
  .hint { margin-bottom: 1rem; }
  .status {
    min-height: 1.2rem;
    margin: -0.5rem 0 0.75rem;
    color: var(--accent);
    font-size: 0.8rem;
  }
  [hidden] { display: none !important; }
  #list-header {
    margin: 1.5rem 0 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .list-title { font-size: 1rem; }
  .list-count { margin: 0.1rem 0 0; color: var(--muted); font-size: 0.75rem; }
  .bookmark { min-width: 0; }
  .bookmark .url { color: inherit; }
  .bookmark .separator { white-space: pre; color: var(--muted); }
  .bookmark .slug { flex: 0 0 auto; color: var(--accent); }
  .bookmark .copy { margin-left: auto; }
  .empty {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding: 1.75rem 1rem;
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    font-size: 0.8rem;
  }
  .empty strong { color: inherit; font-size: 0.9rem; }
  .empty-icon { color: var(--accent); font-size: 1.4rem; }
  @media (max-width: 34rem) {
    .bookmarks { padding: 1rem; }
    form { align-items: stretch; }
    form .field { flex-basis: 100%; }
  }
</style>
